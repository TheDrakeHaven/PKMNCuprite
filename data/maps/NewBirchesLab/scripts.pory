script NewProfessor_EventScript_PokeballOne{
    lockall
    if(!(flag(FLAG_UNUSED_0x020) || flag(FLAG_UNUSED_0x021) || flag(FLAG_UNUSED_0x022)|| flag(FLAG_UNUSED_0x023))){
        if(var(STARTER_TYPE) == 1){
            call(NewProfessor_EventScript_Piplup)
        }
        elif(var(STARTER_TYPE) == 0){
            call(NewProfessor_EventScript_Chimchar)
        }
        elif(var(STARTER_TYPE) == 2){
            call(NewProfessor_EventScript_Turtwig)
        }
    }
    else{
        msgbox("Don't Take Another")
    }
    waitmessage
    releaseall
    end
}
 
