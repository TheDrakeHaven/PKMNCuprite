mapscripts NewBirchesLab_MapScripts{
    MAP_SCRIPT_ON_TRANSITION:NewBircheslab_EventScript_Pokeball 
}

script NewBircheslab_EventScript_Pokeball{
    setvar(STARTER_TYPE, 0)
}

script NewProfessor_EventScript_Birch{
    lockall
    faceplayer
    if(!(flag(FLAG_UNUSED_0x020) || flag(FLAG_UNUSED_0x021) || flag(FLAG_UNUSED_0x022)|| flag(FLAG_UNUSED_0x023))){
        message("Would you like to change the type?")
        multichoice (7,2, MULTI_STARTER_CHOICE, 0)
        closemessage
        if(var(VAR_RESULT) == 0){
            setvar(STARTER_TYPE, 0)
        }
        elif(var(VAR_RESULT) == 1){
            setvar(STARTER_TYPE, 1)
        }
        elif(var(VAR_RESULT) == 2){
            setvar(STARTER_TYPE, 2)
        }
        msgbox("Choose your Pokemon wisely")
        waitmessage
        release
        
    }
    else{
        msgbox("That's the only free one", MSGBOX_NPC)
    }
    waitmessage
    releaseall
    end
}

 
script NewProfessor_EventScript_Totodile{
    showmonpic(SPECIES_TOTODILE, 10,3)
    msgbox("Do you want to choose Totodile?", MSGBOX_YESNO)
    if(var(VAR_RESULT) == YES){
        givemon(SPECIES_TOTODILE, 5, ITEM_EXP_SHARE)
        if(var(VAR_RESULT) == MON_GIVEN_TO_PARTY){
            playfanfare(MUS_OBTAIN_ITEM)
            msgbox("Recieved Totodile")
            removeobject(1)
            setflag(FLAG_UNUSED_0x022)
            call(NicknamePartyMon)
        }
        elif(var(VAR_RESULT) == MON_GIVEN_TO_PC){
            playfanfare(MUS_OBTAIN_ITEM)
            msgbox("Recieved Totodile")
            removeobject(1)
            setflag(FLAG_UNUSED_0x022)
            call(NicknameBoxMon)
        }
        else{
            hidemonpic
            msgbox("No More Room")
        }
    }
    else{
        hidemonpic
        msgbox(NewProfessor_NotChosen)
    }
 
}
 
